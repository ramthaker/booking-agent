  "SeedSlotsBF536987": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "Code": {
     "ZipFile": "\nimport boto3\nimport os\nfrom botocore.exceptions import ClientError\n\ndef handler(event, context):\n    if event.get('RequestType') not in ['Create', 'Update']:\n        return {'PhysicalResourceId': event.get('PhysicalResourceId', 'seed')}\n    \n    table_name = os.getenv('DYNAMODB_TABLE_NAME')\n    dynamodb = boto3.resource('dynamodb')\n    table = dynamodb.Table(table_name)\n    \n    # Seed slots\n    slots = [\n        {'pk': 'SLOT#R-1730', 'sk': 'SLOT', 'doctor': 'Dr Rao', 'clinic': 'West Clinic', 'time': '2026-12-04 17:30', 'available': True},\n        {'pk': 'SLOT#R-1800', 'sk': 'SLOT', 'doctor': 'Dr Rao', 'clinic': 'West Clinic', 'time': '2026-12-04 18:00', 'available': True},\n        {'pk': 'SLOT#S-1600', 'sk': 'SLOT', 'doctor': 'Dr Shah', 'clinic': 'East Clinic', 'time': '2026-12-04 16:00', 'available': True},\n    ]\n    \n    for slot in slots:\n        table.put_item(Item=slot, ConditionExpression='attribute_not_exists(pk)')\n    \n    return {'PhysicalResourceId': 'seed'}\n"
    },
    "Environment": {
     "Variables": {
      "DYNAMODB_TABLE_NAME": {
       "Ref": "BookingTable7E9C9410"
      }
     }
    },
    "Handler": "seed.handler",
    "MemorySize": 128,
    "Role": {
     "Fn::GetAtt": [
      "SeedLambdaRole88DBA302",
      "Arn"
     ]
    },
    "Runtime": "python3.12",
    "Timeout": 10
   },
   "DependsOn": [
    "SeedLambdaRole88DBA302"
   ],
   "Metadata": {
    "aws:cdk:path": "BookingAgentStack/SeedSlots/Resource"
   }
