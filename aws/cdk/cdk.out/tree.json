tion","aws:cdk:cloudformation:logicalId":"SeedSlotsBF536987","aws:cdk:cloudformation:props":{"code":{"zipFile":"\nimport boto3\nimport os\nfrom botocore.exceptions import ClientError\n\ndef handler(event, context):\n    if event.get('RequestType') not in ['Create', 'Update']:\n        return {'PhysicalResourceId': event.get('PhysicalResourceId', 'seed')}\n    \n    table_name = os.getenv('DYNAMODB_TABLE_NAME')\n    dynamodb = boto3.resource('dynamodb')\n    table = dynamodb.Table(table_name)\n    \n    # Seed slots\n    slots = [\n        {'pk': 'SLOT#R-1730', 'sk': 'SLOT', 'doctor': 'Dr Rao', 'clinic': 'West Clinic', 'time': '2026-12-04 17:30', 'available': True},\n        {'pk': 'SLOT#R-1800', 'sk': 'SLOT', 'doctor': 'Dr Rao', 'clinic': 'West Clinic', 'time': '2026-12-04 18:00', 'available': True},\n        {'pk': 'SLOT#S-1600', 'sk': 'SLOT', 'doctor': 'Dr Shah', 'clinic': 'East Clinic', 'time': '2026-12-04 16:00', 'available': True},\n    ]\n    \n    for slot in slots:\n        table.put_item(Item=slot, ConditionExpression='attribute_not_exists(pk)')\n    \n    return {'PhysicalResourceId': 'seed'}\n"},"environment":{"variables":{"DYNAMODB_TABLE_NAME":{"Ref":"BookingTable7E9C9410"}}},"handler":"seed.handler","memorySize":128,"role":{"Fn::GetAtt":["SeedLambdaRole88DBA302","Arn"]},"runtime":"python3.12","timeout":10}}}}},"SeedSlotsResource":{"id":"SeedSlotsResource","path":"BookingAgentStack/SeedSlotsResource","constructInfo":{"fqn":"aws-cdk-lib.CustomResource","version":"2.278.0"},"children":{"Default":{"id":"Default","path":"BookingAgentStack/SeedSlotsResource/Default","constructInfo":{"fqn":"aws-cdk-lib.CfnResource","version":"2.278.0"}}}},"ApiEndpoint":{"id":"ApiEndpoint","path":"BookingAgentStack/ApiEndpoint","constructInfo":{"fqn":"aws-cdk-lib.CfnOutput","version":"2.278.0"}},"TableName":{"id":"TableName","path":"BookingAgentStack/TableName","constructInfo":{"fqn":"aws-cdk-lib.CfnOutput","version":"2.278.0"}},"SecretArn":{"id":"SecretArn","path":"BookingAgen